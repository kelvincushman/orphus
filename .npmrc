# Committed so the supply-chain gate binds every contributor's install, not just
# CI. Mirrors upstream pi's .npmrc, and replaces the `[install]` block bunfig.toml
# carried before the toolchain moved to npm.
save-exact=true

# Release-age cooldown: refuse to resolve a version published in the last N days,
# so a compromised release has to survive a window before it can enter this tree.
#
# `min-release-age` is npm's supported key in npm 11.6 and newer. npm 10.9.7,
# which Node 22 ships, does not enforce a release-age cooldown; contributors who
# want this install-time gate must use npm 11.6 or newer.
#
# `npm ci` installs from the lockfile and is unaffected; this gates `npm install`
# resolving something new, which is where the risk is.
min-release-age=2

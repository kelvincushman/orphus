# Committed so the supply-chain gate binds every contributor's install, not just
# CI. Mirrors upstream pi's .npmrc, and replaces the `[install]` block bunfig.toml
# carried before the toolchain moved to npm.
save-exact=true

# Release-age cooldown: refuse to resolve a version published in the last N days,
# so a compromised release has to survive a window before it can enter this tree.
#
# Two spellings, deliberately. `min-release-age` is what upstream pi carries, and
# is the bunfig-style name — npm 10.9.7, which Node 22 ships and this repo pins,
# has no such config and silently ignores it, so on the pinned toolchain the gate
# was inert rather than enforcing anything. `minimumReleaseAge` is npm's own key,
# added in npm 11.6, and is what actually binds once a contributor is on npm 11.
# Keep both until the repo requires npm 11, then drop the first.
#
# `npm ci` installs from the lockfile and is unaffected; this gates `npm install`
# resolving something new, which is where the risk is.
min-release-age=2
minimumReleaseAge=2

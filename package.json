{
  "name": "@orphus/rooms",
  "version": "0.1.0",
  "description": "Bounded multi-agent discussion for agent harnesses: group chat rooms whose transcripts live outside every agent's context window, read via deterministic budgeted digests.",
  "license": "MIT",
  "type": "module",
  "main": "./src/digest.ts",
  "exports": {
    ".": "./src/digest.ts",
    "./types": "./src/types.ts",
    "./broker": "./src/broker/broker.ts",
    "./client": "./src/broker/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "demo": "bun demo/run-demo.ts",
    "roles": "bun bin/orphus-roles.ts"
  },
  "bin": {
    "orphus-roles": "./bin/orphus-roles.ts"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "dependencies": {
    "tsx": "^4.23.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}

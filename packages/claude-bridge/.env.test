CLAUDE_BRIDGE_TESTING_ALT_PROVIDER=openrouter
# Must tolerate reasoning being disabled: pi sends reasoning effort "none" when
# thinking is off, and a growing number of OpenRouter endpoints reject that
# outright (minimax/minimax-m2.5 and google/gemini-3.6-flash both 400 on it).
CLAUDE_BRIDGE_TESTING_ALT_MODEL=google/gemini-2.5-flash

{
  "name": "@orphus/claude-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "Orphus port of pi-claude-bridge by Eli Dickinson — Claude Code as a provider and AskClaude tool through the Claude Agent SDK.",
  "keywords": [
    "pi-package",
    "atomic-package",
    "pi",
    "extension",
    "claude-code",
    "claude-agent-sdk"
  ],
  "author": "Eli Dickinson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elidickinson/pi-claude-bridge.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "test:unit": "node --import tsx --import ./tests/lib/setup.mjs --test tests/unit-*.mjs",
    "test:compat": "node --import tsx --import ./tests/lib/setup.mjs --test tests/unit-orphus-compat.mjs",
    "test": "set -a && [ -f .env.test ] && . .env.test; set +a && npm run test:unit && tests/int-smoke.sh && tests/int-multi-turn.sh && tests/int-cache.sh && node --import tsx --test tests/int-*.mjs",
    "test:usage": "tests/usage-test.sh",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cc-session-io": "^0.4.0",
    "change-case": "^5.4.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "@orphus/coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "@orphus/coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^24.13.2",
    "tsx": "^4.22.4",
    "typebox": "^1.3.7",
    "typescript": "^6.0.3"
  },
  "orphus": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}

{
  "name": "@bastani/fleet",
  "version": "0.0.0",
  "private": true,
  "description": "Orphus extension for community-shareable fleet orchestration: blueprints bind teams of agents with pre-assigned skills to deliberation rooms and dispatch fan-out.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "*.ts",
    "blueprint/**/*.ts",
    "commands/**/*.ts",
    "skills/**/*",
    "examples/**/*",
    "SCHEMA.md",
    "README.md",
    "LICENSE"
  ],
  "orphus": {
    "extensions": ["./index.ts"],
    "skills": ["./skills"]
  },
  "atomic": {
    "extensions": ["./index.ts"],
    "skills": ["./skills"]
  },
  "pi": {
    "extensions": ["./index.ts"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@bastani/atomic": "*"
  },
  "peerDependenciesMeta": {
    "@bastani/atomic": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}

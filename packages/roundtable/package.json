{
  "name": "@orphus/roundtable",
  "version": "0.0.0",
  "private": true,
  "description": "Atomic extension providing group chat rooms between agent sessions with token-budgeted digests that keep inter-agent discussion out of the context window until pulled.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./bounded-render.ts": "./bounded-render.ts"
  },
  "files": [
    "*.ts",
    "broker/**/*.ts",
    "memory/**/*.ts",
    "bin/**/*.ts",
    "roles/**/*.ts",
    "demo/**/*.ts",
    "skills/**/*",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "orphus": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "atomic": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@orphus/coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@orphus/coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "tsx": "^4.23.1",
    "typebox": "^1.3.7",
    "yaml": "^2.9.0"
  },
  "bin": {
    "orphus-roles": "bin/orphus-roles.ts",
    "orphus-roundtable-mcp": "bin/orphus-roundtable-mcp.ts"
  }
}

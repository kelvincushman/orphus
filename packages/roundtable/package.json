{
  "name": "@bastani/roundtable",
  "version": "0.0.0",
  "private": true,
  "description": "Atomic extension providing group chat rooms between agent sessions with token-budgeted digests that keep inter-agent discussion out of the context window until pulled.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "*.ts",
    "broker/**/*.ts",
    "bin/**/*.ts",
    "memory/**/*.ts",
    "roles/**/*.ts",
    "demo/**/*.ts",
    "skills/**/*",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "orphus": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "atomic": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@bastani/atomic": "*"
  },
  "peerDependenciesMeta": {
    "@bastani/atomic": {
      "optional": true
    }
  },
  "dependencies": {
    "tsx": "^4.23.1",
    "typebox": "^1.3.7",
    "yaml": "^2.9.0"
  }
}

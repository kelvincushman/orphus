{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["bun"],
        "typeRoots": ["./node_modules/@types"],
        "lib": ["ESNext"],
        "allowImportingTsExtensions": true,
        "allowArbitraryExtensions": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "paths": {
            "@orphus/coding-agent": ["./packages/coding-agent/src/index.ts"],
            "@orphus/workflows": ["./packages/workflows/src/index.ts"],
            "@orphus/workflows/builtin": ["./packages/workflows/builtin/index.ts"],
            "@orphus/workflows/builtin/*": ["./packages/workflows/builtin/*"],
            "@orphus/workflows/*": ["./packages/workflows/src/*"],
            "@orphus/subagents": [
                "./packages/subagents/src/extension/index.ts"
            ],
            "@orphus/subagents/*": ["./packages/subagents/src/*"],
            "@orphus/mcp": ["./packages/mcp/index.ts"],
            "@orphus/mcp/*": ["./packages/mcp/*"],
            "@orphus/web-access": ["./packages/web-access/index.ts"],
            "@orphus/web-access/*": ["./packages/web-access/*"],
            "@orphus/intercom": ["./packages/intercom/index.ts"],
            "@orphus/intercom/*": ["./packages/intercom/*"],
            "@orphus/roundtable": ["./packages/roundtable/index.ts"],
            "@orphus/roundtable/*": ["./packages/roundtable/*"],
            "@orphus/transcribe": ["./packages/transcribe/src/index.ts"],
            "@orphus/transcribe/*": ["./packages/transcribe/src/*"]
        }
    },
    "include": [
        "packages/coding-agent/src/**/*.d.ts",
        "packages/workflows/**/*",
        "packages/roundtable/**/*",
        "packages/transcribe/**/*",
        "test/**/*",
        "examples/**/*",
        "evals/longcontext/**/*",
        ".atomic/workflows/**/*"
    ],
    "exclude": [
        "node_modules",
        "packages/coding-agent",
        "packages/subagents",
        "packages/mcp",
        "packages/web-access",
        "packages/intercom"
    ]
}
